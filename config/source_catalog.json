{
  "schema_version": 1,
  "catalog_id": "eight-market-source-catalog-v1",
  "decision_time": "09:00 Asia/Tokyo",
  "source_statuses": [
    "verified",
    "existing_production",
    "candidate",
    "partial_history",
    "derived"
  ],
  "sources": {
    "yahoo_chart": {
      "kind": "aggregated_market_data",
      "history_mode": "daily_ohlcv",
      "access": "https_chart_endpoint",
      "notes": "Primary bulk price source where the one-year history probe passes."
    },
    "eastmoney": {
      "kind": "aggregated_china_hong_kong_data",
      "history_mode": "daily_and_periodic",
      "access": "json_endpoints",
      "notes": "Batch source for mainland indices, turnover, margin and Stock Connect data."
    },
    "deanfi_data": {
      "kind": "aggregated_us_market_breadth",
      "history_mode": "daily_json",
      "access": "dual_keyless_json_endpoints",
      "notes": "S&P 500 constituent breadth with R2 primary and GitHub Raw fallback; stores advances, declines, net breadth and A/D line."
    },
    "sse_margin_api": {
      "kind": "official_mainland_margin_summary",
      "history_mode": "date_range_json",
      "access": "keyless_json",
      "notes": "Official SSE aggregate margin-financing history; one request accepts a date range."
    },
    "szse_margin_api": {
      "kind": "official_mainland_margin_summary",
      "history_mode": "daily_json",
      "access": "keyless_json_throttled",
      "notes": "Official SZSE aggregate margin-financing observation; historical backfill must use the five-minute source queue."
    },
    "aastocks_hk_market": {
      "kind": "aggregated_hong_kong_market_statistics",
      "history_mode": "rolling_15_trading_days",
      "access": "html_embedded_series",
      "notes": "One response supplies market short turnover, long turnover, total turnover and short-selling ratio; parser schema is monitored."
    },
    "hkma_api": {
      "kind": "aggregated_hong_kong_monetary_data",
      "history_mode": "daily_observations",
      "access": "keyless_json",
      "notes": "Verified machine-readable daily HIBOR history from the HKMA Open API."
    },
    "fred_csv": {
      "kind": "aggregated_rates_and_credit_data",
      "history_mode": "daily_observations",
      "access": "keyless_csv",
      "notes": "One adapter covers US 2Y, US 10Y, US real yield and US high-yield spread."
    },
    "coinmarketcap": {
      "kind": "aggregated_crypto_data",
      "history_mode": "latest_and_entitled_history",
      "access": "authenticated_api",
      "notes": "CMC v5 derivatives endpoints provide latest per-market funding, open interest and basis. No dedicated derivatives-funding historical endpoint is currently documented, so CMC validates the daily aggregate but is not used to bootstrap the funding history."
    },
    "exchange_funding_apis": {
      "kind": "public_crypto_derivatives_history",
      "history_mode": "settled_funding_history",
      "access": "keyless_rest_apis",
      "notes": "Binance, OKX and Bybit public APIs provide BTC/ETH perpetual settled-funding history without a browser. Rates are normalized to an 8-hour equivalent and the daily metric uses a cross-venue median; venue components and method version are retained."
    },
    "coinglass": {
      "kind": "aggregated_crypto_derivatives",
      "history_mode": "latest_and_visible_history",
      "access": "controlled_browser",
      "notes": "Existing controlled-browser source for liquidation and open-interest aggregates. The BTC futures page also exposes an OI-weighted funding-rate chart; the new adapter records BTC and ETH separately and an OI-weighted composite."
    },
    "tradingview": {
      "kind": "aggregated_market_data_fallback",
      "history_mode": "daily_ohlcv",
      "access": "pinned_node_websocket_adapter",
      "package": "@mathieuc/tradingview@3.5.2",
      "notes": "Non-browser adapter to TradingView's private WebSocket protocol. Anonymous one-year history is verified; optional session cookies are read only from environment variables. Browser/CDP is the operational fallback."
    },
    "eia_bulk": {
      "kind": "official_energy_bulk_data",
      "history_mode": "weekly_and_monthly_json_lines",
      "access": "keyless_zip_bulk",
      "notes": "PET.zip supplies weekly commercial crude stocks; INTL.zip supplies monthly country production used by a versioned OPEC+ membership aggregation."
    },
    "opec_momr": {
      "kind": "official_monthly_doc_production",
      "history_mode": "latest_official_monthly_total",
      "access": "public_pdf",
      "notes": "Latest official OPEC Monthly Oil Market Report DoC crude-production total; used ahead of lagging all-country EIA completion and never labeled as a daily actual."
    },
    "cftc_public": {
      "kind": "official_positioning_data",
      "history_mode": "weekly_api_and_annual_files",
      "access": "keyless_socrata_or_csv",
      "notes": "Official COT public reporting environment and annual compressed files; stores per-metal managed-money long, short, net and percent of open interest."
    },
    "world_gold_council": {
      "kind": "aggregated_physically_backed_gold_fund_flows",
      "history_mode": "monthly_workbook_and_release_archive",
      "access": "public_download_with_release_page_fallback",
      "notes": "Monthly global physically backed gold ETF flow, holdings and AUM. Gold is the explicitly defined fund-flow proxy for the precious-metals domain."
    },
    "usda_esmis": {
      "kind": "official_crop_progress_reports",
      "history_mode": "weekly_text_release_archive",
      "access": "keyless_json_catalog_and_text",
      "notes": "USDA ESMIS API exposes 1,100+ Crop Progress releases and machine-readable text-file URLs; parser extracts US condition/progress rows at native weekly cadence."
    },
    "imf_portwatch": {
      "kind": "aggregated_ais_port_trade_estimates",
      "history_mode": "daily_observations_weekly_refresh",
      "access": "keyless_arcgis_json",
      "notes": "Daily dry-bulk port calls and export-tonnage estimates for Odessa, Chornomorsk, Pivdennyi and Novorossiysk; retains PortWatch estimation and release-lag metadata."
    },
    "open_meteo": {
      "kind": "aggregated_weather",
      "history_mode": "daily_history_and_forecast",
      "access": "keyless_json",
      "notes": "Weather observations and forecast for the Black Sea port cluster; weather is stored separately from modeled export tonnage."
    },
    "farside": {
      "kind": "aggregated_spot_etf_flows",
      "history_mode": "daily_table",
      "access": "reader_or_browser",
      "notes": "Daily US BTC and ETH spot-ETF tables; the production metric is their combined net flow in USD millions with both components retained."
    },
    "bykaranteli_public": {
      "kind": "aggregated_crypto_etf_and_derivatives_data",
      "history_mode": "daily_json",
      "access": "keyless_json",
      "notes": "One public dataset supplies BTC/ETH spot-ETF flows and another supplies multi-venue liquidation history. Liquidation totals are explicitly retained as a conservative public-stream floor."
    },
    "openbb_connectors": {
      "kind": "provider_aggregation_layer",
      "history_mode": "provider_dependent",
      "access": "python_connectors",
      "notes": "Candidate wrapper for EIA, CFTC, IMF and financial-news providers; install only selected extensions."
    },
    "straits_live": {
      "kind": "aggregated_hormuz_transits",
      "history_mode": "daily_history_weekly_release",
      "access": "keyless_json",
      "notes": "Candidate API backed by IMF PortWatch; provenance and release lag are retained."
    },
    "marketaux": {
      "kind": "aggregated_financial_news",
      "history_mode": "api_window_queries",
      "access": "authenticated_api",
      "notes": "Selected news candidate. It aggregates global financial news; plan limits and historical pagination require a capability probe."
    },
    "alpha_vantage_news": {
      "kind": "aggregated_historical_financial_news",
      "history_mode": "time_bounded_api_queries",
      "access": "authenticated_api",
      "notes": "Candidate historical-news and backup adapter with time range, topic, relevance sort and up to 1000 returned articles per request."
    },
    "financial_aggregator_pool": {
      "kind": "aggregated_specialized_market_data",
      "history_mode": "provider_dependent",
      "access": "adapter",
      "notes": "Selection pool for breadth, China/HK flows, HIBOR, OPEC+, fund flows, crop state and Black Sea data."
    }
  },
